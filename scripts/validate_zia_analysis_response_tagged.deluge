map validate_zia_analysis_response_tagged(string raw_response, map trusted_request)
{
trusted_message = ifnull(trusted_request.get("message"),Map());
trusted_context = ifnull(trusted_request.get("crm_context"),Map());
cleaned_response = ifnull(raw_response,"").trim();
cleaned_response = cleaned_response.replaceAll("```json","");
cleaned_response = cleaned_response.replaceAll("```","").trim();
parse_ok = true;
analysis = Map();
try
{
	analysis = cleaned_response.toMap();
}
catch (e)
{
	parse_ok = false;
	analysis = Map();
}
intent = analysis.get("intent");
if(intent == null)
{
	intent = Map();
	intent.put("category","unknown");
	intent.put("summary","");
}
opportunity_signals = analysis.get("opportunity_signals");
if(opportunity_signals == null)
{
	opportunity_signals = List();
}
lifecycle = analysis.get("lifecycle_interpretation");
if(lifecycle == null)
{
	lifecycle = Map();
	lifecycle.put("observed_stage","");
	lifecycle.put("recommended_stage",null);
	lifecycle.put("change_recommended",false);
	lifecycle.put("evidence",List());
}
recommendation = analysis.get("recommendation");
if(recommendation == null)
{
	recommendation = Map();
	recommendation.put("action","manual_review");
	recommendation.put("confidence_band","low");
	recommendation.put("rationale","Zia response could not be validated.");
	recommendation.put("review_notes","Review the original email manually.");
}
match_status = ifnull(trusted_context.get("match_status"),"");
matched_module = ifnull(trusted_context.get("matched_module"),"");
matched_record_id = ifnull(trusted_context.get("matched_record_id"),"").toString();
if(match_status == "matched" && matched_module != "" && matched_record_id != "")
{
	recommendation.put("target_module",matched_module);
	recommendation.put("target_record_id",matched_record_id);
}
else
{
	recommendation.put("action","manual_review");
	recommendation.put("confidence_band","low");
	recommendation.put("rationale","No matching Contact, Lead, or Account was found.");
	recommendation.put("review_notes","Review this email manually and associate or create the appropriate CRM record.");
	recommendation.put("target_module","");
	recommendation.put("target_record_id","");
}
safety = analysis.get("safety");
if(safety == null)
{
	safety = Map();
}
safety.put("human_approval_required",true);
safety.put("closed_won_change_requested",ifnull(safety.get("closed_won_change_requested"),false));
safety.put("quote_generation_requested",ifnull(safety.get("quote_generation_requested"),false));
conflicts = safety.get("conflicts");
if(conflicts == null)
{
	conflicts = List();
}
if(parse_ok == false)
{
	safety.put("contains_insufficient_context",true);
	conflicts.add("invalid_zia_json_response");
}
else if(match_status != "matched")
{
	safety.put("contains_insufficient_context",true);
	conflicts.add("crm_record_not_found");
}
else
{
	safety.put("contains_insufficient_context",ifnull(safety.get("contains_insufficient_context"),false));
}
safety.put("conflicts",conflicts);
validation_status = "fallback";
if(match_status == "matched" && matched_module != "" && matched_record_id != "")
{
	validation_status = "valid";
}
validated = Map();
validated.put("schema_version","1.0");
validated.put("message_id",ifnull(trusted_message.get("message_id"),"").toString());
validated.put("idempotency_key",ifnull(trusted_message.get("idempotency_key"),""));
validated.put("intent",intent);
validated.put("opportunity_signals",opportunity_signals);
validated.put("lifecycle_interpretation",lifecycle);
validated.put("recommendation",recommendation);
validated.put("safety",safety);
validated.put("validation_status",validation_status);
validated.put("raw_zia_response",ifnull(raw_response,""));
return validated;
}
