map normalize_form_entry(string form_id, string submitter_email, string first_name, string last_name, string company, string phone, string area_of_interest, string comments, string submitted_at)
{
normalized = Map();
form_key = ifnull(form_id,"").toString().trim();
if(form_key == "")
{
	form_key = "KB_Website_Form";
}
from_email = ifnull(submitter_email,"").toString().trim().toLowerCase();
from_domain = "";
email_parts = from_email.toList("@");
if(email_parts.size() == 2)
{
	from_domain = email_parts.get(1);
}
given_name = ifnull(first_name,"").toString().trim();
family_name = ifnull(last_name,"").toString().trim();
from_name = (given_name + " " + family_name).trim();
company_name = ifnull(company,"").toString().trim();
phone_number = ifnull(phone,"").toString().trim();
interest = ifnull(area_of_interest,"").toString().trim();
comment_text = ifnull(comments,"").toString().trim();
submitted_text = ifnull(submitted_at,"").toString().trim();
entry_key = from_email + ":" + submitted_text;
subject = "Website inquiry";
if(interest != "")
{
	subject = "Website inquiry: " + interest;
}
if(company_name != "")
{
	subject = subject + " - " + company_name;
}
if(subject.length() > 255)
{
	subject = subject.subString(0,254);
}
body_lines = List();
if(from_name != "")
{
	body_lines.add("Name: " + from_name);
}
if(company_name != "")
{
	body_lines.add("Company: " + company_name);
}
if(from_email != "")
{
	body_lines.add("Email: " + from_email);
}
if(phone_number != "")
{
	body_lines.add("Phone: " + phone_number);
}
if(interest != "")
{
	body_lines.add("Area of Interest: " + interest);
}
if(submitted_text != "")
{
	body_lines.add("Submitted: " + submitted_text);
}
body_text = body_lines.toString("\n");
if(comment_text != "")
{
	body_text = body_text + "\n\n" + comment_text;
}
is_valid_sender = email_parts.size() == 2 && from_domain.contains(".");
is_internal_sender = from_domain == "bevco-tech.com" || from_domain == "kinetic-bridge.com";
should_process = is_valid_sender && !is_internal_sender;
skip_reason = "";
if(!is_valid_sender)
{
	skip_reason = "submitter_email_invalid";
}
else if(is_internal_sender)
{
	skip_reason = "internal_sender_outbound_copy";
}
normalized.put("schema_version","1.0");
normalized.put("source","zoho_forms");
normalized.put("portal_id",form_key);
normalized.put("event_id",entry_key);
normalized.put("event_name","NEW_FORM_ENTRY");
normalized.put("message_id",entry_key);
normalized.put("idempotency_key","zohoform:" + form_key + ":" + entry_key);
normalized.put("from_name",from_name);
normalized.put("from_email",from_email);
normalized.put("to_email","");
normalized.put("cc_email","");
normalized.put("bcc_email","");
normalized.put("subject",subject);
normalized.put("summary",comment_text);
normalized.put("body_html",body_text);
normalized.put("sent_at_ms",submitted_text);
normalized.put("received_at_ms",submitted_text);
normalized.put("should_process",should_process);
normalized.put("skip_reason",skip_reason);
normalized.put("from_domain",from_domain);
normalized.put("is_internal_sender",is_internal_sender);
normalized.put("is_form_intake",true);
normalized.put("relay_email","");
normalized.put("envelope_email",from_email);
normalized.put("company_name",company_name);
normalized.put("phone",phone_number);
normalized.put("area_of_interest",interest);
return normalized;
}
